# ---------- Banco (Supabase → Project Settings → Database → Connection string → "Transaction pooler", porta 6543)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Use "false" só para Postgres local sem SSL
DATABASE_SSL=true

# ---------- Segurança: um texto aleatório longo (ex.: rode `openssl rand -base64 48`)
AUTH_SECRET=troque-por-um-texto-aleatorio-bem-longo

# Protege a rotina diária /api/cron (a Vercel envia esse valor sozinha)
CRON_SECRET=outro-texto-aleatorio

# ---------- IA (Llama)
# Padrão: Groq, gratuito, roda Llama na nuvem → crie a chave em https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_sua_chave_aqui
LLM_MODEL=llama-3.3-70b-versatile
# Alternativa local com Ollama (só funciona rodando no seu computador):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ---------- Primeira administradora (usado só pelo `npm run setup`)
ADMIN_NOME=Rayssa Paiva
ADMIN_USUARIO=rayssa.paiva
ADMIN_EMAIL=seu.email@exemplo.com
